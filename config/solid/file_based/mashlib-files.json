{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
  "import": [
    "css:config/app/main/default.json",
    "css:config/app/init/initialize-root.json",
    "css:config/app/variables/default.json",
    "css:config/http/handler/default.json",
    "css:config/http/middleware/default.json",
    "css:config/http/notifications/all.json",
    "css:config/http/server-factory/http.json",
    "css:config/http/static/default.json",
    "css:config/identity/access/public.json",
    "/config/account_recovery/email.json",
    "css:config/identity/handler/default.json",
    "css:config/identity/oidc/default.json",
    "css:config/identity/ownership/token.json",
    "css:config/identity/pod/static.json",
    "css:config/ldp/authentication/dpop-bearer.json",
    "css:config/ldp/authorization/webacl.json",
    "css:config/ldp/handler/default.json",
    "css:config/ldp/metadata-parser/default.json",
    "css:config/ldp/metadata-writer/default.json",
    "css:config/ldp/modes/default.json",
    "css:config/storage/backend/file.json",
    "css:config/storage/key-value/resource-store.json",
    "css:config/storage/location/root.json",
    "css:config/storage/middleware/default.json",
    "css:config/util/auxiliary/acl.json",
    "css:config/util/identifiers/suffix.json",
    "css:config/util/logging/winston.json",
    "css:config/util/representation-conversion/default.json",
    "css:config/util/resource-locker/memory.json",
    "css:config/util/variables/default.json"
  ],
  "@graph": [
    {
      "comment": [
        "A filesystem-based server with Databrowser as UI.",
        "Derived from config/file-no-setup.json"
      ]
    },

    {
      "comment": "Serve Databrowser as default representation",
      "@id": "urn:solid-server:default:DefaultUiConverter",
      "@type": "ConstantConverter",
      "contentType": "text/html",
      "filePath": "./node_modules/mashlib/dist/databrowser.html",
      "options_container": true,
      "options_document": true,
      "options_minQuality": 1,
      "options_disabledMediaRanges": ["image/*", "application/pdf"]
    },

    {
      "comment": "Serve Mashlib static files from /dist/ folder.",
      "@id": "urn:solid-server:default:StaticAssetHandler",
      "@type": "StaticAssetHandler",
      "assets": [
        {
          "@type": "StaticAssetEntry",
          "relativeUrl": "/",
          "filePath": "./node_modules/mashlib/dist/"
        },
        {
          "comment": "Theme: served instead of the dist mash.css; imports it via /mash-origin.css.",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/mash.css",
          "filePath": "/config/theming/redpencil.css"
        },
        {
          "comment": "Alias so the themed stylesheet can import the stock mash.css.",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/mash-origin.css",
          "filePath": "./node_modules/mashlib/dist/mash.css"
        },
        {
          "comment": "Theme: branded identity pages (/.account/*, /idp/*) instead of the stock main.css.",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/.well-known/css/styles/main.css",
          "filePath": "/config/theming/idp.css"
        },
        {
          "comment": "Theme: redpencil dot instead of the stock Solid logo on identity pages.",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/.well-known/css/images/solid.svg",
          "filePath": "/config/theming/logo-dot.svg"
        }
      ]
    },

    {
      "comment": "Generate new pods from the checked-out templates instead of the stock CSS templates.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:PodResourcesGenerator" },
      "overrideParameters": {
        "@type": "StaticFolderGenerator",
        "templateFolder": "/templates/pod"
      }
    },

    {
      "comment": "Allow legacy --email* flags until this is miigrated.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server-app-setup:default:CliExtractor" },
      "overrideParameters": {
        "@type": "YargsCliExtractor",
        "options": {
          "usage": "node ./bin/server.js [args]",
          "envVarPrefix": "CSS",
          "loadFromEnv": true,
          "strictMode": false
        }
      }
    }
  ]
}
