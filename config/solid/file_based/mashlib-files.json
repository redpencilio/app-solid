{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
  "import": [
    "css:config/app/init/initialize-root.json",
    "css:config/app/main/default.json",
    "css:config/app/variables/default.json",
    "css:config/http/handler/default.json",
    "css:config/http/middleware/default.json",
    "css:config/http/notifications/all.json",
    "css:config/http/server-factory/http.json",
    "css:config/http/static/default.json",
    "css:config/identity/access/public.json",
    "css:config/identity/email/default.json",
    "css:config/identity/handler/default.json",
    "css:config/identity/oidc/default.json",
    "css:config/identity/ownership/token.json",
    "css:config/ldp/authentication/dpop-bearer.json",
    "css:config/ldp/authorization/webacl.json",
    "css:config/ldp/handler/default.json",
    "css:config/ldp/metadata-parser/default.json",
    "css:config/ldp/metadata-writer/default.json",
    "css:config/ldp/modes/default.json",
    "css:config/storage/backend/file.json",
    "css:config/storage/key-value/resource-store.json",
    "css:config/storage/location/pod.json",
    "css:config/storage/middleware/default.json",
    "css:config/util/auxiliary/acl.json",
    "css:config/util/identifiers/suffix.json",
    "css:config/util/logging/winston.json",
    "css:config/util/representation-conversion/default.json",
    "css:config/util/resource-locker/file.json",
    "css:config/util/variables/default.json"
  ],
  "@graph": [
    {
      "comment": "A filesystem-based server with the redpencil.io Mashlib UI."
    },

    {
      "comment": "Wire PodManager to use the default ResourceStore and our PodResourcesGenerator.",
      "@id": "urn:solid-server:default:PodManager",
      "@type": "GeneratedPodManager",
      "store": { "@id": "urn:solid-server:default:ResourceStore" },
      "resourcesGenerator": { "@id": "urn:solid-server:default:PodResourcesGenerator" }
    },

    {
      "comment": "Use custom pod templates (base/ content + wac/ ACL files).",
      "@id": "urn:solid-server:default:PodResourcesGenerator",
      "@type": "StaticFolderGenerator",
      "templateFolder": "/templates/pod",
      "resourcesGenerator": { "@id": "urn:solid-server:default:TemplatedResourcesGenerator" }
    },

    {
      "comment": "Generate resources from the base/ subfolder; webacl.json adds wac/ via this same @id.",
      "@id": "urn:solid-server:default:TemplatedResourcesGenerator",
      "@type": "SubfolderResourcesGenerator",
      "subfolders": [ "base" ],
      "resourcesGenerator": {
        "@type": "BaseResourcesGenerator",
        "factory": { "@type": "ExtensionBasedMapperFactory" },
        "templateEngine": { "@id": "urn:solid-server:default:TemplateEngine" },
        "metadataStrategy": { "@id": "urn:solid-server:default:MetadataStrategy" },
        "store": { "@id": "urn:solid-server:default:ResourceStore" }
      }
    },

    {
      "comment": "Serve the Mashlib DataBrowser (with embedded marketing page) as the default HTML representation.",
      "@id": "urn:solid-server:default:DefaultUiConverter",
      "@type": "ConstantConverter",
      "contentType": "text/html",
      "filePath": "./custom/databrowser.html",
      "options_container": true,
      "options_document": true,
      "options_minQuality": 1,
      "options_disabledMediaRanges": ["image/*", "application/pdf"]
    },

    {
      "comment": "Serve Mashlib and redpencil.io brand assets.",
      "@id": "urn:solid-server:default:StaticAssetHandler",
      "@type": "StaticAssetHandler",
      "assets": [
        {
          "@id": "urn:solid-server:custom:MashlibCssAsset",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/mash.css",
          "filePath": "./node_modules/mashlib/dist/mash.css"
        },
        {
          "@id": "urn:solid-server:custom:MashlibJsAsset",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/mashlib.min.js",
          "filePath": "./node_modules/mashlib/dist/mashlib.min.js"
        },
        {
          "@id": "urn:solid-server:custom:MashlibJsMapAsset",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/mashlib.min.js.map",
          "filePath": "./node_modules/mashlib/dist/mashlib.min.js.map"
        },
        {
          "@id": "urn:solid-server:custom:RedpencilThemeAsset",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/redpencil-theme.css",
          "filePath": "./custom/redpencil-theme.css"
        },
        {
          "@id": "urn:solid-server:custom:IdpThemeAsset",
          "@type": "StaticAssetEntry",
          "relativeUrl": "/.well-known/css/styles/main.css",
          "filePath": "./custom/idp-theme.css"
        }
      ]
    }
  ]
}
